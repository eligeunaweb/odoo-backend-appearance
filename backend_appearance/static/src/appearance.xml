<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="backend_appearance.Panel">
        <section class="o_action overflow-auto ba-editor">
            <div class="ba-editor-inner mx-auto p-3 p-md-4">
                <header class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
                    <div>
                        <h1 class="mb-1">Backend Appearance</h1>
                        <p class="text-muted mb-0">Changes preview live in this tab until applied.</p>
                    </div>
                    <div>
                        <label for="ba-scope" class="form-label">Appearance scope</label>
                        <select id="ba-scope" class="form-select" t-att-value="editor.scope"
                                t-att-disabled="editor.busy || dirty" t-on-change="switchScope">
                            <option value="global" t-att-selected="editor.scope === 'global'">Global</option>
                            <option value="company" t-att-selected="editor.scope === 'company'"><t t-esc="companyName"/></option>
                        </select>
                    </div>
                </header>
                <nav class="nav nav-pills flex-wrap gap-1 mb-3" aria-label="Appearance sections">
                    <button t-foreach="tabs" t-as="tab" t-key="tab.id" type="button" class="nav-link"
                            t-att-class="{active: editor.tab === tab.id}" t-att-aria-pressed="editor.tab === tab.id ? 'true' : 'false'"
                            t-att-data-section="tab.id" t-on-click="switchTab"><t t-esc="tab.name"/></button>
                </nav>

                <button type="button" class="btn btn-outline-secondary d-xl-none mb-3"
                        aria-controls="ba-sample" t-att-aria-expanded="editor.previewOpen ? 'true' : 'false'"
                        t-on-click="toggleSample">Theme preview</button>
                <div class="ba-editor-layout">
                <fieldset class="ba-editor-card p-3 p-md-4" t-att-disabled="editor.busy">
                    <div class="ba-editor-page" t-att-class="{'ba-editor-page-active': editor.tab === 'bar'}">
                        <h2 class="h4">Top bar</h2>
                        <label for="ba-mode" class="form-label">Background</label>
                        <select id="ba-mode" class="form-select w-auto mb-3" t-model="form.navbar_mode">
                            <option value="color">Solid color</option>
                            <option value="pattern">Pattern</option>
                            <option value="photo">Photo</option>
                        </select>
                        <div t-if="form.navbar_mode !== 'photo'" class="mb-3">
                            <label class="form-label d-block" for="ba-navbar">Top bar color</label>
                            <input id="ba-navbar" type="color" t-att-value="form.navbar || '#ffffff'"
                                   t-on-input="(ev) => form.navbar = ev.target.value"/>
                            <button type="button" class="btn btn-secondary ms-2" t-on-click="() => form.navbar = ''">Use Odoo default</button>
                        </div>
                        <fieldset t-if="form.navbar_mode === 'pattern'">
                            <legend class="form-label fs-6">Top bar pattern</legend>
                            <div class="d-flex flex-wrap gap-2">
                                <button t-foreach="patterns" t-as="pattern" t-key="pattern.id"
                                        type="button" class="btn btn-outline-secondary d-flex flex-column gap-1"
                                        t-att-data-pattern="pattern.id"
                                        t-att-aria-pressed="form.navbar_pattern === pattern.id ? 'true' : 'false'"
                                        t-att-class="{active: form.navbar_pattern === pattern.id}" t-on-click="selectPattern">
                                    <span class="ba-pattern-swatch rounded w-100" t-att-data-ba-pattern="pattern.id" aria-hidden="true"/>
                                    <span t-esc="pattern.label"/>
                                </button>
                            </div>
                            <label for="ba-intensity" class="form-label mt-3">Pattern intensity</label>
                            <div class="d-flex gap-3">
                                <input id="ba-intensity" type="range" class="form-range w-auto" min="0" max="100"
                                       t-att-value="form.pattern_intensity" t-on-input="(ev) => form.pattern_intensity = ev.target.value"/>
                                <output for="ba-intensity"><t t-esc="form.pattern_intensity"/>%</output>
                            </div>
                        </fieldset>
                        <div t-if="form.navbar_mode === 'photo'">
                            <label for="ba-photo" class="form-label">Top bar photo</label>
                            <input id="ba-photo" type="file" class="form-control w-auto mw-100" data-field="navbar_photo"
                                   accept="image/png,image/jpeg,image/webp" t-on-change="uploadPhoto"/>
                            <div class="form-text">PNG, JPEG or WebP, up to 4 MB. The photo replaces the color and pattern while active.</div>
                            <div t-if="form.navbar_photo" class="mt-3">
                                <img class="ba-photo-thumbnail rounded" t-att-src="'data:image/jpeg;base64,' + form.navbar_photo"
                                     t-att-style="'object-position: center ' + form.photo_position + '%'"
                                     alt="Selected top bar photo"/>
                                <button type="button" class="btn btn-outline-secondary ms-2" data-field="navbar_photo" t-on-click="removePhoto">Remove photo</button>
                                <label for="ba-position" class="form-label d-block mt-3">Vertical photo position</label>
                                <input id="ba-position" type="range" class="form-range w-auto" min="0" max="100"
                                       t-att-value="form.photo_position" t-on-input="(ev) => form.photo_position = ev.target.value"/>
                            </div>
                        </div>
                        <div class="row g-3 border-top mt-3 pt-3">
                            <div t-foreach="images" t-as="image" t-key="image.id" class="col-sm-6">
                                <label class="form-label" t-att-for="'ba-image-' + image.id"><t t-esc="image.label"/></label>
                                <input t-att-id="'ba-image-' + image.id" type="file" class="form-control mw-100"
                                       t-att-data-field="image.id" accept="image/png,image/jpeg,image/webp" t-on-change="uploadPhoto"/>
                                <div t-if="form[image.id]" class="d-flex gap-2 align-items-center mt-2">
                                    <img class="ba-brand-thumbnail" t-att-src="'data:image/jpeg;base64,' + form[image.id]" alt=""/>
                                    <button type="button" class="btn btn-outline-secondary" t-att-data-field="image.id" t-on-click="removePhoto">Remove image</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="ba-editor-page" t-att-class="{'ba-editor-page-active': editor.tab === 'menu'}">
                        <h2 class="h4">Apps menu</h2>
                        <div class="d-flex flex-wrap gap-2">
                            <button t-foreach="menuStyles" t-as="style" t-key="style.id" type="button"
                                    class="btn btn-outline-secondary ba-menu-tile"
                                    t-att-data-menu-style="style.id"
                                    t-att-aria-pressed="form.apps_menu === style.id ? 'true' : 'false'"
                                    t-att-class="{active: form.apps_menu === style.id}" t-on-click="selectMenu">
                                <span class="ba-menu-tile-preview" t-att-data-style="style.id" aria-hidden="true"><i/><i/><i/></span>
                                <t t-esc="style.name"/>
                            </button>
                        </div>
                        <div t-if="form.apps_menu === 'custom'" class="d-flex flex-wrap align-items-start gap-3 mt-3">
                            <div>
                                <label class="form-label d-block" for="ba-apps-background">Apps menu background</label>
                                <input id="ba-apps-background" type="color" t-att-value="form.apps_menu_background"
                                       t-on-input="(ev) => form.apps_menu_background = ev.target.value"/>
                            </div>
                            <div>
                                <label class="form-label d-block" for="ba-apps-highlight">Apps menu highlight</label>
                                <input id="ba-apps-highlight" type="color" t-att-value="form.apps_menu_highlight"
                                       t-on-input="(ev) => form.apps_menu_highlight = ev.target.value"/>
                            </div>
                        </div>
                    </div>

                    <div class="ba-editor-page" t-att-class="{'ba-editor-page-active': editor.tab === 'workspace'}">
                        <h2 class="h4">Workspace</h2>
                        <div class="mb-3">
                            <label class="form-label d-block" for="ba-accent">Accent color</label>
                            <input id="ba-accent" type="color" t-att-value="form.accent || '#714b67'"
                                   t-on-input="(ev) => form.accent = ev.target.value"/>
                            <button type="button" class="btn btn-secondary ms-2" t-on-click="() => form.accent = ''">Use Odoo default</button>
                        </div>
                        <div class="d-flex flex-wrap gap-3">
                            <div>
                                <label class="form-label" for="ba-density">Density</label>
                                <select id="ba-density" class="form-select" t-model="form.density">
                                    <option value="compact">Compact</option>
                                    <option value="normal">Normal</option>
                                    <option value="spacious">Spacious</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label" for="ba-text">Text size</label>
                                <select id="ba-text" class="form-select" t-model="form.text_size">
                                    <option value="standard">Standard</option>
                                    <option value="large">Large</option>
                                </select>
                            </div>
                        </div>
                        <div class="ba-density-sample mt-3" t-att-data-density="form.density" aria-hidden="true">
                            <div><span>Contact</span><span>Email</span></div>
                            <div><span>María López</span><span>maria@example.com</span></div>
                            <div><span>Alex Morgan</span><span>alex@example.com</span></div>
                        </div>
                    </div>

                    <div class="ba-editor-page" t-att-class="{'ba-editor-page-active': editor.tab === 'themes'}">
                        <h2 class="h4">Themes</h2>
                        <p class="text-muted">Load a theme into the preview and apply it when ready.</p>
                        <label for="ba-theme-name" class="form-label">Theme name</label>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <input id="ba-theme-name" class="form-control w-auto" maxlength="60" t-model="editor.themeName"/>
                            <button type="button" class="btn btn-secondary" t-att-disabled="!editor.themeName.trim()" t-on-click="saveTheme">Save theme</button>
                        </div>
                        <label for="ba-theme-select" class="form-label">Saved themes</label>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <select id="ba-theme-select" class="form-select w-auto" t-model="editor.selectedTheme">
                                <option value="">Choose a theme</option>
                                <option t-foreach="editor.themes" t-as="theme" t-key="theme" t-att-value="theme" t-esc="theme"/>
                            </select>
                            <button type="button" class="btn btn-secondary" t-att-disabled="!editor.selectedTheme" t-on-click="loadTheme">Load theme</button>
                            <button type="button" class="btn btn-outline-secondary" t-att-disabled="!editor.selectedTheme" t-on-click="deleteTheme">Delete theme</button>
                        </div>
                        <label for="ba-import" class="form-label">Import JSON</label>
                        <div class="d-flex flex-wrap gap-2">
                            <input id="ba-import" type="file" class="form-control w-auto mw-100" accept=".json,application/json" t-on-change="importTheme"/>
                            <button type="button" class="btn btn-outline-secondary" t-on-click="exportTheme">Export JSON</button>
                        </div>
                    </div>
                </fieldset>
                <aside id="ba-sample" class="ba-sample d-xl-block"
                       t-att-class="{'d-none': !editor.previewOpen}" aria-labelledby="ba-sample-title">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h2 id="ba-sample-title" class="h5 mb-0">Theme preview</h2>
                        <div class="btn-group" role="group" aria-label="Compare appearance">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-comparison="before"
                                    t-att-aria-pressed="editor.comparison === 'before' ? 'true' : 'false'"
                                    t-att-class="{active: editor.comparison === 'before'}" t-on-click="compareSample">Before</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-comparison="after"
                                    t-att-aria-pressed="editor.comparison === 'after' ? 'true' : 'false'"
                                    t-att-class="{active: editor.comparison === 'after'}" t-on-click="compareSample">After</button>
                        </div>
                    </div>
                    <t t-set="design" t-value="sample"/>
                    <div class="ba-sample-frame" t-att-style="design.style" t-att-data-text="design.text" aria-hidden="true">
                        <div class="ba-sample-bar" t-att-data-ba-pattern="design.pattern" t-att-data-photo="design.photo ? 'true' : 'false'">
                            <img t-if="design.logo" t-att-src="design.logo" alt=""/>
                            <i class="oi oi-apps"/>
                            <span>Contacts</span>
                        </div>
                        <div class="ba-sample-body">
                            <div class="ba-sample-menu">
                                <span>Discuss</span><span>Contacts</span><span>Sales</span>
                            </div>
                            <div class="ba-sample-list" t-att-data-density="design.density">
                                <span class="ba-sample-accent">New</span>
                                <div><strong>Contact</strong><strong>City</strong></div>
                                <div><span>María López</span><span>Madrid</span></div>
                                <div><span>Alex Morgan</span><span>London</span></div>
                            </div>
                        </div>
                    </div>
                </aside>
                </div>

                <footer class="ba-editor-actions d-flex flex-wrap align-items-center gap-2 py-3">
                    <button type="button" class="btn btn-primary" t-att-disabled="editor.busy || !dirty" t-on-click="apply">Apply changes</button>
                    <button type="button" class="btn btn-secondary" t-att-disabled="editor.busy || !dirty" t-on-click="discard">Discard changes</button>
                    <div class="small text-muted me-auto">
                        <div t-if="dirty" role="status">Unsaved changes</div>
                        <div t-if="editor.scope === 'global'">Applies to companies using the global appearance.</div>
                        <div t-else="">
                            <span>Applies only to</span> <strong t-esc="companyName"/>
                            <div t-if="editor.inheritsGlobal">Currently inherits the global appearance.</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-secondary ms-auto" t-att-disabled="editor.busy" t-on-click="restore">
                        <t t-if="editor.scope === 'company'">Use global appearance</t>
                        <t t-else="">Restore defaults</t>
                    </button>
                </footer>
            </div>
        </section>
    </t>
</templates>
