<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="backend_appearance.Panel">
        <section class="o_action overflow-auto p-4">
            <h1>Backend Appearance</h1>
            <p>Preview changes in this tab, then return here to apply or discard them.</p>
            <fieldset t-att-disabled="form.busy">
                <div class="mb-3">
                    <label class="form-label" for="ba-accent">Accent color</label>
                    <div class="d-flex gap-2">
                        <input id="ba-accent" type="color" t-att-value="form.accent || '#714b67'"
                               t-on-input="(ev) => form.accent = ev.target.value"/>
                        <button class="btn btn-secondary" t-on-click="() => form.accent = ''">Use Odoo default</button>
                    </div>
                </div>
                <div t-if="!form.navbar_photo" class="mb-3">
                    <label class="form-label" for="ba-navbar">Top bar color</label>
                    <div class="d-flex gap-2">
                        <input id="ba-navbar" type="color" t-att-value="form.navbar || '#ffffff'"
                               t-on-input="(ev) => form.navbar = ev.target.value"/>
                        <button class="btn btn-secondary" t-on-click="() => form.navbar = ''">Use Odoo default</button>
                    </div>
                </div>
                <div t-if="!form.navbar_photo" class="mb-3">
                    <fieldset>
                        <legend class="form-label fs-6">Top bar pattern</legend>
                        <div class="d-flex flex-wrap gap-2">
                            <button t-foreach="patterns" t-as="pattern" t-key="pattern.id"
                                    type="button" class="btn btn-outline-secondary d-flex flex-column gap-1"
                                    t-att-data-pattern="pattern.id"
                                    t-att-aria-pressed="form.navbar_pattern === pattern.id ? 'true' : 'false'"
                                    t-att-class="{active: form.navbar_pattern === pattern.id}"
                                    t-on-click="selectPattern">
                                <span class="ba-pattern-swatch rounded w-100"
                                      t-att-data-ba-pattern="pattern.id" aria-hidden="true"/>
                                <span t-esc="pattern.label"/>
                            </button>
                        </div>
                        <div t-if="form.navbar_pattern !== 'solid'" class="mt-3">
                            <label class="form-label" for="ba-intensity">Pattern intensity</label>
                            <div class="d-flex align-items-center gap-3">
                                <input id="ba-intensity" type="range" class="form-range w-auto"
                                       min="0" max="100" t-model="form.pattern_intensity"/>
                                <output for="ba-intensity"><t t-esc="form.pattern_intensity"/>%</output>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ba-photo">Top bar photo</label>
                    <input id="ba-photo" type="file" class="form-control w-auto mw-100"
                           accept="image/png,image/jpeg,image/webp" t-on-change="uploadPhoto"/>
                    <div class="form-text">PNG, JPEG or WebP, up to 4 MB. The photo replaces the color and pattern while active.</div>
                    <div t-if="form.navbar_photo" class="d-flex flex-wrap align-items-center gap-2 mt-2">
                        <img class="ba-photo-thumbnail rounded" t-att-src="'data:image/jpeg;base64,' + form.navbar_photo"
                             alt="Selected top bar photo"/>
                        <button type="button" class="btn btn-outline-secondary" t-on-click="removePhoto">Remove photo</button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ba-apps-menu">Apps menu style</label>
                    <select id="ba-apps-menu" class="form-select w-auto" t-model="form.apps_menu">
                        <option value="standard">Odoo default</option>
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                        <option value="custom">Custom</option>
                    </select>
                    <div t-if="form.apps_menu === 'custom'" class="d-flex flex-wrap gap-3 mt-2">
                        <div>
                            <label class="form-label d-block" for="ba-apps-background">Apps menu background</label>
                            <input id="ba-apps-background" type="color" t-att-value="form.apps_menu_background"
                                   t-on-input="(ev) => form.apps_menu_background = ev.target.value"/>
                        </div>
                        <div>
                            <label class="form-label d-block" for="ba-apps-highlight">Apps menu highlight</label>
                            <input id="ba-apps-highlight" type="color" t-att-value="form.apps_menu_highlight"
                                   t-on-input="(ev) => form.apps_menu_highlight = ev.target.value"/>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ba-density">Density</label>
                    <select id="ba-density" class="form-select w-auto" t-model="form.density">
                        <option value="compact">Compact</option>
                        <option value="normal">Normal</option>
                        <option value="spacious">Spacious</option>
                    </select>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-secondary" t-on-click="preview">Preview</button>
                    <button class="btn btn-primary" t-on-click="apply">Apply</button>
                    <button class="btn btn-secondary" t-on-click="discard">Discard preview</button>
                    <button class="btn btn-outline-secondary" t-on-click="restore">Restore defaults</button>
                </div>
            </fieldset>
        </section>
    </t>
</templates>
